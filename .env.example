# Secret used to sign login sessions (change in production: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string
# First admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@spinexhome.in
ADMIN_PASSWORD=Spinex@2026
# Optional: Razorpay keys (can also be set from Admin → Settings → Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public URL of the site (used for SEO/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
